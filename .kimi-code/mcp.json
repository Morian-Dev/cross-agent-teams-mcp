{
  "mcpServers": {
    "cross-agent-teams": {
      "url": "http://127.0.0.1:9100/mcp",
      "headers": {
        "Authorization": "Bearer xats"
      }
    },
    "cross-agent-teams-channel": {
      "command": "npx",
      "args": [
        "-y",
        "-p",
        "cross-agent-teams-mcp@latest",
        "cross-agent-teams-channel",
        "--daemon-url",
        "http://127.0.0.1:9100/mcp",
        "--token",
        "xats"
      ],
      "enabled": false
    }
  }
}
